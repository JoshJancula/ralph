{
  "name": "Orch JSON Characterization",
  "namespace": "orch-json-characterization",
  "stages": [
    {
      "id": "research",
      "runtime": "cursor",
      "nativeSubagents": "inherit",
      "outputArtifacts": [
        {
          "path": ".ralph-workspace/artifacts/{{ARTIFACT_NS}}/research.md",
          "required": true
        }
      ],
      "artifacts": [
        {
          "path": ".ralph-workspace/artifacts/{{ARTIFACT_NS}}/research.md",
          "required": true
        }
      ],
      "plan": "{{WS}}/.ralph-workspace/orchestration-plans/orch-json-characterization/orch-json-characterization-01-research.plan.md"
