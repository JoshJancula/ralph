#!/usr/bin/env bash
# Run "bash RUNNER_SCRIPT" under a pseudo-TTY.
# Use the Python PTY helper so scripted stdin reaches the child consistently.
set -euo pipefail
runner="${1:?runner script path required}"
repo_root="$(cd "$(dirname "$0")/../../.." && pwd)"
exec "$repo_root/tests/bats/bin/ralph-pty-exec" bash "$runner"
