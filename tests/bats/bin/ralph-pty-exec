#!/usr/bin/env python3
"""Run a command with stdin and stdout on a real PTY (portable; GNU script is inconsistent)."""
import os
import pty
import sys

def main() -> None:
    if len(sys.argv) < 2:
        print("usage: ralph-pty-exec command [args...]", file=sys.stderr)
        sys.exit(2)
    cmd = sys.argv[1:]
    try:
        status = pty.spawn(cmd)
    except OSError as exc:
        print(exc, file=sys.stderr)
        sys.exit(127)
    if os.WIFEXITED(status):
        sys.exit(os.WEXITSTATUS(status))
    if os.WIFSIGNALED(status):
        sys.exit(128 + os.WTERMSIG(status))
    sys.exit(1)


if __name__ == "__main__":
    main()
