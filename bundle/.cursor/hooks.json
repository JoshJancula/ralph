{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": ".cursor/hooks/pre-tool-shell-policy.sh",
        "matcher": "Shell"
      },
      {
        "command": ".cursor/hooks/pre-tool-proxy-read-handoff.sh",
        "matcher": "MCP:ralph_proxy_read"
      },
      {
        "command": ".cursor/hooks/pre-tool-exploration-policy.sh",
        "matcher": "Read|read|readToolCall|Grep|grep|grepToolCall|Glob|glob|globToolCall|SemanticSearch|semanticSearch"
      }
    ],
    "postToolUse": [
      {
        "command": ".cursor/hooks/post-tool-shell-telemetry.sh",
        "matcher": "Shell"
      },
      {
        "command": ".cursor/hooks/post-tool-native-result-compact.sh",
        "matcher": "Read|read|readToolCall|Grep|grep|grepToolCall|Glob|glob|globToolCall|SemanticSearch|semanticSearch"
      },
      {
        "command": ".cursor/hooks/post-tool-mcp-compact.sh",
        "matcher": "MCP:*"
      }
    ],
    "afterShellExecution": [
      {
        "command": ".cursor/hooks/after-shell-telemetry.sh"
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/stop-continuation.sh",
        "timeout": 5400,
        "loop_limit": 5
      }
    ]
  }
}
