  "versionFile": "plugins/ralph-orchestrator/VERSION",
  "outputRoot": "plugins/ralph-orchestrator",
  "engine": {
    "delivery": "external-cli",
    "command": "ralph",
    "pluginApi": 1
  },
  "agents": [
    "architect",
    "code-review",
    "implementation",
    "qa",
    "research",
