      "destination": "skills/ralph-run/SKILL.md",
      "mode": "0644"
    },
    {
      "source": "bundle/.ralph/plugin-inputs/workflows/ralph-status.md",
      "destination": "skills/ralph-status/SKILL.md",
      "mode": "0644"
    },
    {
      "source": "bundle/.ralph/plugin-inputs/workflows/ralph-workflow.md",
      "destination": "skills/ralph-workflow/SKILL.md",
      "mode": "0644"
    },
    {
      "source": "bundle/.ralph/plugin-inputs/workflows/ralph-doctor.md",
      "destination": "workflows/ralph-doctor.md",
      "mode": "0644"
    },
    {
      "source": "bundle/.ralph/plugin-inputs/workflows/ralph-plan.md",
      "destination": "workflows/ralph-plan.md",
      "mode": "0644"
    },
    {
      "source": "bundle/.ralph/plugin-inputs/workflows/ralph-run.md",
      "destination": "workflows/ralph-run.md",
      "mode": "0644"
    },
    {
      "source": "bundle/.ralph/plugin-inputs/workflows/ralph-status.md",
      "destination": "workflows/ralph-status.md",
      "mode": "0644"
    },
    {
      "source": "bundle/.ralph/plugin-inputs/workflows/ralph-workflow.md",
      "destination": "workflows/ralph-workflow.md",
      "mode": "0644"
    }
  ]
}
