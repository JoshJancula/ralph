{
  "schemaVersion": 1,
  "runtime": "opencode",
  "outputDirectory": "plugins/ralph-orchestrator/opencode",
  "contract": "bundle/.ralph/plugin-inputs/contracts/opencode.json",
  "capabilities": {
    "nativeAgents": false,
    "nativeHooks": true,
    "mcp": true,
    "rules": false,
    "skills": true,
    "workflows": true
  },
  "copies": [
