      "destination": "shared/ralph-plugin-bootstrap.sh",
      "mode": "0755"
    },
    {
      "source": "bundle/.ralph/plugin-inputs/shared/ralph-plugin-exec.sh",
      "destination": "shared/ralph-plugin-exec.sh",
      "mode": "0755"
    }
  ],
  "templates": [
