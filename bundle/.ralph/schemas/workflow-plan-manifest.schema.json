{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "producerStageId",
    "producerAttempt",
    "sourceArtifact",
    "planPath",
    "planSha256",
    "todoCount",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [1]
    },
    "producerStageId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "producerAttempt": {
      "type": "integer",
      "minimum": 1
    },
    "sourceArtifact": {
      "type": "string",
      "pattern": "^/.+$"
    },
    "planPath": {
      "type": "string",
      "pattern": "^/.+$"
    },
    "planSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "todoCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "createdAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
