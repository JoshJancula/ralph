{
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "criteria"],
  "properties": {
    "id": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "required", "check"],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "check": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "file_exists",
                  "json_pointer",
                  "regex",
                  "command",
                  "citation",
                  "model_judgment"
                ]
              },
              "path": {
                "type": "string"
              },
              "pointer": {
                "type": "string"
              },
              "pattern": {
                "type": "string"
              },
              "command": {
                "type": "string"
              },
              "ref": {
                "type": "string"
              },
              "excerpt": {
                "type": "string"
              },
              "prompt": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
