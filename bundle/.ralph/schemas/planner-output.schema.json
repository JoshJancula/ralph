{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "overview",
    "rationale",
    "todos"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [2]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "overview": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "todos": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "content",
          "verification",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["pending"]
          },
          "runtime": {
            "type": "string",
            "enum": [
              "cursor",
              "claude",
              "codex",
              "opencode",
              "antigravity"
            ]
          },
          "model": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
