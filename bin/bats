#!/usr/bin/env bash
# Ralph wrapper: always pass -T so each test prints its duration (pretty or tap).
# Put repo bin/ on PATH (see .envrc) so plain `bats tests/bats/*.bats` shows timings.

set -euo pipefail

ralph_bin="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

find_system_bats() {
  local IFS=':'
  local dir
  local -a path_parts=()
  for dir in $PATH; do
    [[ -z "$dir" || "$dir" == "$ralph_bin" ]] && continue
    path_parts+=("$dir")
  done
  PATH="${path_parts[*]}"
  unset IFS
  command -v bats
}

args=()
enable_timing=1
jobs_requested=0
jobs_value=""
expect_jobs_value=0
saw_parallel_flag=0
for arg in "$@"; do
  if [[ "$expect_jobs_value" -eq 1 ]]; then
    jobs_value="$arg"
    expect_jobs_value=0
    args+=("$arg")
    continue
  fi
  case "$arg" in
    -T | --timing)
      enable_timing=1
      args+=("$arg")
      ;;
    --no-timing)
      enable_timing=0
      ;;
    -j | --jobs)
      jobs_requested=1
      expect_jobs_value=1
      args+=("$arg")
      ;;
    -j=* | --jobs=*)
      jobs_requested=1
      jobs_value="${arg#*=}"
      args+=("$arg")
      ;;
    --no-parallelize-within-files | --no-parallelize-across-files)
      saw_parallel_flag=1
      args+=("$arg")
      ;;
    *)
      args+=("$arg")
      ;;
  esac
done

# `bats -j N` does not cap total concurrency: bats-exec-suite runs N files under
# GNU parallel and passes -j N down to each bats-exec-file, which then runs N
# tests of its own. With N files in flight that is N*N concurrent tests -- `-j 8`
# over 8 files is up to 64, which on this repo's process-spawning suites has
# saturated a 10-core host badly enough to take the machine down.
#
# scripts/run-bats.sh has capped this for a while, but bin/bats is the other way
# in and had no guard, so a direct `bin/bats -j 8 ...` still hit it. Add the same
# cap here unless the caller has explicitly chosen a parallelization mode.
# bats rejects --no-parallelize-within-files below --jobs 2, so the cap must not
# be added for -j 1. That combination is how a caller asks for a fully serial
# run -- CI's serial recheck step does exactly this -- and adding the flag there
# turned it into an immediate hard error rather than a serial run.
if [[ "$jobs_requested" -eq 1 && "$saw_parallel_flag" -eq 0 ]] \
  && [[ "$jobs_value" =~ ^[0-9]+$ ]] && [[ "$jobs_value" -ge 2 ]]; then
  args+=(--no-parallelize-within-files)
fi

system_bats="$(find_system_bats || true)"
if [[ -z "$system_bats" ]]; then
  echo "bin/bats: system bats not found on PATH (install bats-core)" >&2
  exit 127
fi

if [[ "$enable_timing" -eq 1 ]]; then
  exec "$system_bats" -T "${args[@]}"
fi

exec "$system_bats" "${args[@]}"
