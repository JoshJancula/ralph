{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "RALPH_BASH_COMPACT=1 \"${CLAUDE_PLUGIN_ROOT}/hooks/compact-bash-output.sh\"",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/native-result-compact.sh\"",
            "type": "command"
          }
        ],
        "matcher": "Read|Grep|Glob"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/block-env-reads.sh\"",
            "type": "command"
          }
        ],
        "matcher": "Read|Edit|MultiEdit|Glob|Grep|LS"
      },
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/rewrite-bash-command.sh\"",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ]
  }
}
